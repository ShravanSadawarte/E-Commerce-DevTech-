PORT=5000
NODE_ENV=development

# ============================================================================
# SUPABASE CONFIGURATION (PostgreSQL Backend)
# ============================================================================
SUPABASE_URL=https://REDACTED_SUPABASE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend

# Optional: If frontend needs direct Supabase access (with restrictions)
# VITE_SUPABASE_URL=https://REDACTED_SUPABASE_PROJECT_ID.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# LEGACY DATABASE (Deprecated - keeping for reference)
# ============================================================================
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=nexora_ecommerce
# DB_USER=root
# DB_PASSWORD=your_mysql_password

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
JWT_SECRET=your_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway (Test / Live Credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email SMTP
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
