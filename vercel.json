{
  "version": 2,
  "installCommand": "npm run install:all && npm rebuild sqlite3 --prefix server --unsafe-perm || true",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
